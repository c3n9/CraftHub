<Styles xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentPrimary}" />
        <Setter Property="ContextFlyout">
            <MenuFlyout>
                <MenuItem Header="{DynamicResource TbCut}"
                          Command="{Binding $parent[TextBox].Cut}"
                          InputGesture="Ctrl+X" />
                <MenuItem Header="{DynamicResource TbCopy}"
                          Command="{Binding $parent[TextBox].Copy}"
                          InputGesture="Ctrl+C" />
                <MenuItem Header="{DynamicResource TbPaste}"
                          Command="{Binding $parent[TextBox].Paste}"
                          InputGesture="Ctrl+V" />
                <Separator />
                <MenuItem Header="{DynamicResource TbSelectAll}"
                          Command="{Binding $parent[TextBox].SelectAll}"
                          InputGesture="Ctrl+A" />
            </MenuFlyout>
        </Setter>
    </Style>
    <Style Selector="TextBox:focus /template/ Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
    </Style>
    <Style Selector="TextBox.json-editor">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="TextBox.json-editor /template/ Border">
        <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="TextBox.json-editor:pointerover /template/ Border">
        <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="TextBox.json-editor:focus /template/ Border">
        <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="TextBox.json-editor:focus-within /template/ Border">
        <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BoxShadow" Value="none" />
    </Style>

    <!-- Comparer pane title: reads as a heading, not as a form field — centred, with only an
         underline instead of a full box, which turns accent-coloured on focus. -->
    <Style Selector="TextBox.panel-label">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="4,2" />
        <!-- Fluent gives TextBox a ~32px minimum; the underline is pinned to the bottom of that, so
             leaving it in place shows a large gap under the text. -->
        <Setter Property="MinHeight" Value="0" />
        <!-- Otherwise the field's own minimum sets the floor for how narrow a pane can get. -->
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.panel-label /template/ Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BoxShadow" Value="none" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TextBox.panel-label /template/ DockPanel">
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="TextBox.panel-label:pointerover /template/ Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style Selector="TextBox.panel-label:focus /template/ Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
    </Style>

    <!-- The in-cell editor. A cell is often narrower than its value (long JSON, a long formula,
         a URL with no spaces to wrap at), so both scrollbars are explicitly Auto: without them the
         text simply slid out of view with nothing on screen saying it could be scrolled. MaxHeight
         keeps a multi-line value from pushing the row taller than the grid. -->
    <Style Selector="TextBox.grid-editor">
        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="6,4" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="MaxHeight" Value="220" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- Make the editor's scrollbars usable rather than the 2px overlay default. -->
    <Style Selector="TextBox.grid-editor /template/ ScrollViewer">
        <Setter Property="AllowAutoHide" Value="False" />
    </Style>

</Styles>
