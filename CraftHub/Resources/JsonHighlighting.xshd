<?xml version="1.0" encoding="utf-8"?>
<!-- JSON highlighting for CraftHub. Colours are muted mid-tones so they stay
     legible on both the light and dark editor background. -->
<SyntaxDefinition name="Json" extensions=".json"
                  xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">

    <Color name="FieldName"   foreground="#3B82F6" />
    <Color name="String"      foreground="#3FA45B" />
    <Color name="Number"      foreground="#B7791F" />
    <Color name="Bool"        foreground="#C0392B" />
    <Color name="Null"        foreground="#9B59B6" />
    <Color name="Punctuation" foreground="#8A8F98" />

    <RuleSet>
        <Keywords color="Bool">
            <Word>true</Word>
            <Word>false</Word>
        </Keywords>
        <Keywords color="Null">
            <Word>null</Word>
        </Keywords>

        <!-- Property name: a quoted string that is immediately followed by a colon.
             Must come before the generic string span so keys colour differently. -->
        <Rule color="FieldName">
            "[^"\\]*(?:\\.[^"\\]*)*"\s*(?=:)
        </Rule>

        <!-- String value -->
        <Span color="String" multiline="false">
            <Begin>"</Begin>
            <End>"</End>
            <RuleSet>
                <!-- keep escape sequences inside the string -->
                <Span begin="\\" end="." />
            </RuleSet>
        </Span>

        <!-- Numbers -->
        <Rule color="Number">
            \-?\b\d+(\.\d+)?([eE][+\-]?\d+)?\b
        </Rule>

        <!-- Structural punctuation -->
        <Rule color="Punctuation">
            [{}\[\],:]
        </Rule>
    </RuleSet>
</SyntaxDefinition>
