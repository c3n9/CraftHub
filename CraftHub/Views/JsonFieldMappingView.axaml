<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:CraftHub.ViewModels"
		xmlns:models="using:CraftHub.Domain.Models"
		xmlns:conv="using:CraftHub.Converters"
		xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
		x:Class="CraftHub.Views.JsonFieldMappingView"
		x:Name="DialogRoot"
		Title="Import JSON"
		Width="650" Height="500"
		MinWidth="650" MinHeight="500"
		WindowStartupLocation="CenterOwner"
		Background="{DynamicResource AppBackground}"
		CanResize="False">

	<Window.Resources>
		<conv:DepthToMarginConverter x:Key="DepthToMargin" />
	</Window.Resources>

	<Grid RowDefinitions="Auto,*,Auto">

		<!-- Header -->
		<Border Grid.Row="0" Background="{DynamicResource SurfaceBackground}" Padding="20,16">
			<StackPanel Spacing="4">
				<StackPanel Orientation="Horizontal" Spacing="5">
					<TextBlock Text="Configure Field Types"
							   FontSize="18" FontWeight="SemiBold"
							   Foreground="{DynamicResource TextPrimary}" />
					<TextBlock Text="{Binding FileName}"
							   FontSize="18" FontWeight="SemiBold"
							   Foreground="{DynamicResource AccentPrimary}"
							   TextWrapping="Wrap"
							   MaxWidth="400"
							   MaxLines="1"
							   TextTrimming="CharacterEllipsis"
							   IsVisible="{Binding FileName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
				</StackPanel>
				<TextBlock Text="Select the data type for each detected JSON field."
						   FontSize="13" Foreground="{DynamicResource TextSecondary}" />
				<TextBlock Text="Nested objects stay in one column — use the arrow to split one into separate columns."
						   FontSize="12" TextWrapping="Wrap"
						   Foreground="{DynamicResource TextMuted}" />

			</StackPanel>
		</Border>

		<!-- Fields list -->
		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible">
			<ItemsControl ItemsSource="{Binding Fields}" Margin="10">
				<ItemsControl.ItemTemplate>
					<DataTemplate DataType="{x:Type models:JsonFieldMapping}">
						<Border Background="{DynamicResource ElevatedBackground}" CornerRadius="8"
								Padding="16,12"
								Margin="{Binding Depth, Converter={StaticResource DepthToMargin}}"
								BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
							<Grid ColumnDefinitions="24,*,Auto,Auto">

								<!-- Expand/collapse: replaces a nested object with one column per child -->
								<Button Grid.Column="0"
										Classes="transparentBtn"
										Padding="0"
										Width="24" Height="24"
										IsVisible="{Binding CanExpand}"
										Command="{Binding DataContext.ToggleExpandCommand, ElementName=DialogRoot}"
										CommandParameter="{Binding}">
									<Panel>
										<materialIcons:MaterialIcon Kind="ChevronRight" Width="18" Height="18"
																	IsVisible="{Binding !IsExpanded}"
																	Foreground="{DynamicResource TextSecondary}" />
										<materialIcons:MaterialIcon Kind="ChevronDown" Width="18" Height="18"
																	IsVisible="{Binding IsExpanded}"
																	Foreground="{DynamicResource AccentPrimary}" />
									</Panel>
								</Button>

								<StackPanel Grid.Column="1" Spacing="2" Margin="6,0,0,0">
									<TextBlock Text="{Binding DisplayName}"
											   FontSize="14" FontWeight="SemiBold"
											   Foreground="{DynamicResource TextPrimary}" />
									<TextBlock FontSize="12" Foreground="{DynamicResource TextMuted}"
											   MaxLines="1" TextTrimming="CharacterEllipsis">
										<TextBlock.Text>
											<MultiBinding StringFormat="Sample: {0}">
												<Binding Path="SampleValue" />
											</MultiBinding>
										</TextBlock.Text>
									</TextBlock>
								</StackPanel>

								<TextBlock Grid.Column="2"
										   VerticalAlignment="Center"
										   Margin="12,0"
										   FontSize="12" Foreground="{DynamicResource TextSecondary}">
									<TextBlock.Text>
										<MultiBinding StringFormat="detected: {0}">
											<Binding Path="DetectedType" />
										</MultiBinding>
									</TextBlock.Text>
								</TextBlock>

								<ComboBox Grid.Column="3"
										  ItemsSource="{Binding DataContext.AvailableTypes, ElementName=DialogRoot}"
										  SelectedItem="{Binding SelectedType, Mode=TwoWay}"
										  IsVisible="{Binding IsTypeSelectable}"
										  Width="130" FontSize="13"
										  CornerRadius="6"
										  VerticalAlignment="Center" />

								<!-- An expanded object is not a column itself, so it has no type -->
								<TextBlock Grid.Column="3"
										   Text="split into columns"
										   Width="130"
										   FontSize="12" FontStyle="Italic"
										   TextAlignment="Center"
										   VerticalAlignment="Center"
										   IsVisible="{Binding IsExpanded}"
										   Foreground="{DynamicResource TextMuted}" />
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>

		<!-- Footer buttons -->
		<Border Grid.Row="2" Background="{DynamicResource SurfaceBackground}" Padding="16,12"
				BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
				<Button Content="{DynamicResource BtnCancel}" Classes="tab-btn"
						VerticalContentAlignment="Center"
						HorizontalContentAlignment="Center"
						Height="34"
						x:Name="CancelButton" MinWidth="80" />
				<Button Content="{DynamicResource BtnImport}" Classes="accent-btn"
						Height="34"
						VerticalContentAlignment="Center"
						HorizontalContentAlignment="Center"
						x:Name="ConfirmButton" MinWidth="80" />
			</StackPanel>
		</Border>
	</Grid>
</Window>
