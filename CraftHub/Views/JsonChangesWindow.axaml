<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CraftHub.ViewModels"
        xmlns:views="using:CraftHub.Views"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="CraftHub.Views.JsonChangesWindow"
        x:DataType="vm:JsonChangesWindowViewModel"
        Title="{Binding Title}"
        Width="1000" Height="700"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">

    <!-- Window level so the shortcuts work regardless of which control has focus. -->
    <Window.KeyBindings>
        <KeyBinding Gesture="F7" Command="{Binding Diff.PreviousChangeCommand}" />
        <KeyBinding Gesture="F8" Command="{Binding Diff.NextChangeCommand}" />
    </Window.KeyBindings>

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBackground}" Padding="16,12"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="FileCompare" Width="20" Height="20"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource AccentPrimary}" />
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimary}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Classes="toolbar-btn" Command="{Binding CopyDiffCommand}"
                            ToolTip.Tip="{DynamicResource DiffCopyTip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="ContentCopy" Width="16" Height="16" />
                            <TextBlock Text="{DynamicResource DiffCopyBtn}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="toolbar-btn" Command="{Binding SaveAsPatchCommand}"
                            ToolTip.Tip="{DynamicResource DiffSavePatchTip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="16" Height="16" />
                            <TextBlock Text="{DynamicResource DiffSavePatchBtn}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Padding="0" Margin="8,4,8,8">
            <TabItem Header="{DynamicResource DiffTabText}">
                <views:DiffView DataContext="{Binding Diff}" />
            </TabItem>
            <TabItem Header="{DynamicResource DiffTabStructural}">
                <views:StructuralDiffView DataContext="{Binding Structural}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
