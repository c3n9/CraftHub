<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="CraftHub.Views.FormulaReferenceWindow"
        Title="{DynamicResource FormulaRefTitle}"
        Width="900" Height="720"
        MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBackground}" Padding="16,12"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="FunctionVariant" Width="20" Height="20"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource AccentPrimary}" />
                    <TextBlock Text="{DynamicResource FormulaRefTitle}" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimary}" />
                </StackPanel>

                <!-- Filters the function list below. The prose sections stay put: they're the part
                     you read once, the list is the part you come back to look something up in. -->
                <TextBox Grid.Column="1"
                         x:Name="SearchBox"
                         Margin="16,0,0,0"
                         MinWidth="200"
                         HorizontalAlignment="Right"
                         Watermark="{DynamicResource FormulaRefSearchWatermark}"
                         TextChanged="OnSearchChanged" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <!-- No MaxWidth and no Left alignment: those pinned every block to 820px against the
                 left edge, so maximising the window just added empty space on the right. -->
            <StackPanel Spacing="18" Margin="20,16,20,24">

                <StackPanel x:Name="ProseSections" Spacing="18" />

                <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,4" />

                <TextBlock Text="{DynamicResource FormulaRefFunctionsHeading}"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="{DynamicResource FormulaRefFunctionsIntro}"
                           TextWrapping="Wrap" Opacity="0.75"
                           Foreground="{DynamicResource TextSecondary}" />

                <StackPanel x:Name="FunctionSections" Spacing="16" />

                <TextBlock x:Name="NoMatchesText"
                           Text="{DynamicResource FormulaRefNoMatches}"
                           IsVisible="False"
                           Opacity="0.7"
                           Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
