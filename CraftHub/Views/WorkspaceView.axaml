<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CraftHub.ViewModels"
             xmlns:views="using:CraftHub.Views"
             xmlns:models="using:CraftHub.Domain.Models"
             xmlns:services="using:CraftHub.Services"
             xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:cl="clr-namespace:Coachlight.Avalonia.Targeting;assembly=Coachlight.Avalonia"
             xmlns:ae="using:AvaloniaEdit"
             x:Class="CraftHub.Views.WorkspaceView"
             x:DataType="vm:WorkspaceViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
        <KeyBinding Gesture="Ctrl+F" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Gesture="Ctrl+H" Command="{Binding ToggleReplaceCommand}" />
    </UserControl.KeyBindings>

    <Panel>
    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Toolbar Row 1: Actions -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBackground}" Padding="8,6"
                CornerRadius="8" Margin="8,8,8,0">
            <Grid x:Name="ToolbarRoot" ColumnDefinitions="*,Auto">
                <StackPanel x:Name="ToolbarButtons" Grid.Column="0" Orientation="Horizontal" Spacing="4"
                            ClipToBounds="True">

                    <Button Classes="toolbar-btn" Command="{Binding SaveCommand}"
                            cl:Coachmark.Id="wsSave"
                            ToolTip.Tip="{DynamicResource SaveTip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="16" Height="16" />
                            <TextBlock Text="{DynamicResource SaveBtn}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border x:Name="LeadSep" Width="1" Background="{DynamicResource BorderLight}" Margin="6,4" />

                    <!-- Import / export buttons — individually collapse into the … menu when the toolbar is narrow -->
                    <Button x:Name="BtnImportJson" Classes="toolbar-btn" Command="{Binding ImportJsonCommand}"
                            cl:Coachmark.Id="importJson"
                            ToolTip.Tip="{DynamicResource ImportJsonTip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="FileImportOutline" Width="16" Height="16" />
                            <TextBlock Text="{DynamicResource ImportJson}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnExportJson" Classes="toolbar-btn" Command="{Binding ExportJsonCommand}"
                            cl:Coachmark.Id="exportJson"
                            ToolTip.Tip="{DynamicResource ExportJsonTip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="FileExportOutline" Width="16" Height="16" />
                            <TextBlock Text="{DynamicResource ExportJson}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnImportClass" Classes="toolbar-btn" Command="{Binding ImportClassCommand}"
                            ToolTip.Tip="{DynamicResource ImportClassTip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="FileCodeOutline" Width="16" Height="16" />
                            <TextBlock Text="{DynamicResource ImportClass}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnExportClass" Classes="toolbar-btn" Command="{Binding ExportClassCommand}"
                            ToolTip.Tip="{DynamicResource ExportClassTip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="FileCode" Width="16" Height="16" />
                            <TextBlock Text="{DynamicResource ExportClass}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border x:Name="ClusterSep" Width="1" Background="{DynamicResource BorderLight}" Margin="6,4"
                            IsVisible="{Binding IsTableEditorMode}" />

                    <Button Classes="toolbar-btn"
                            cl:Coachmark.Id="wsAddRow"
                            Command="{Binding AddRowCommand}"
                            ToolTip.Tip="{DynamicResource AddRowTip}"
                            IsVisible="{Binding IsTableEditorMode}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="TableRowPlusAfter" Width="16" Height="16" />
                            <TextBlock Text="{DynamicResource AddRowBtn}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    
                    <Border Width="1" Background="{DynamicResource BorderLight}" Margin="6,4"
                            IsVisible="{Binding #OverflowButton.IsVisible}" />

                    <!-- Overflow menu — only shown when one or more buttons do not fit -->
                    <Button x:Name="OverflowButton" Classes="toolbar-btn"
                            IsVisible="False" VerticalAlignment="Center"
                            ToolTip.Tip="{DynamicResource MoreActionsTip}">
                            <materialIcons:MaterialIcon Kind="DotsVertical" Width="18" Height="18" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem x:Name="MiImportJson" Header="{DynamicResource ImportJson}"
                                          IsVisible="False" Command="{Binding ImportJsonCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="FileImportOutline" Width="16" Height="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="MiExportJson" Header="{DynamicResource ExportJson}"
                                          IsVisible="False" Command="{Binding ExportJsonCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="FileExportOutline" Width="16" Height="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="MiImportClass" Header="{DynamicResource ImportClass}"
                                          IsVisible="False" Command="{Binding ImportClassCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="FileCodeOutline" Width="16" Height="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="MiExportClass" Header="{DynamicResource ExportClass}"
                                          IsVisible="False" Command="{Binding ExportClassCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="FileCode" Width="16" Height="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <Border Width="1" Background="{DynamicResource BorderLight}" Margin="6,4"
                            IsVisible="{Binding IsTableEditorMode}" />

                    <Button Classes="toolbar-btn"
                            Command="{Binding UndoCommand}"
                            ToolTip.Tip="{Binding UndoTooltip}"
                            IsVisible="{Binding IsTableEditorMode}">
                        <materialIcons:MaterialIcon Kind="Undo" Width="16" Height="16" />
                    </Button>
                    <Button Classes="toolbar-btn"
                            Command="{Binding RedoCommand}"
                            ToolTip.Tip="{Binding RedoTooltip}"
                            IsVisible="{Binding IsTableEditorMode}">
                        <materialIcons:MaterialIcon Kind="Redo" Width="16" Height="16" />
                    </Button>
                    <Button Classes="toolbar-btn"
                            cl:Coachmark.Id="wsHistory"
                            ToolTip.Tip="{DynamicResource HistoryTip}"
                            IsVisible="{Binding IsTableEditorMode}">
                        <materialIcons:MaterialIcon Kind="TimelineClockOutline" Width="16" Height="16" />
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel Spacing="6" Width="240">
                                    <TextBlock Text="{DynamicResource HistoryTitle}" FontSize="12"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                    <ScrollViewer MaxHeight="280" x:Name="HistoryScrollViewer">
                                        <ItemsControl ItemsSource="{Binding UndoRedo.HistoryEntries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="services:HistoryEntry">
                                                    <Button Classes="history-item" Classes.current="{Binding IsCurrent}"
                                                            Content="{Binding Description}"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Click="OnHistoryEntryClick" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Available in both table and JSON mode: the diff is taken from the document,
                         not from whichever editor happens to be showing it. -->
                    <Button Classes="toolbar-btn"
                            cl:Coachmark.Id="wsShowChanges"
                            Command="{Binding ShowChangesCommand}"
                            ToolTip.Tip="{DynamicResource ShowChangesTip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="FileCompare" Width="16" Height="16" />
                            <TextBlock Text="{DynamicResource ShowChangesBtn}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="{DynamicResource BorderLight}" Margin="6,4"
                            IsVisible="{Binding IsTableEditorMode}" />

                    <TextBox x:Name="SearchBox" Text="{Binding SearchQuery}" Watermark="{DynamicResource SearchWatermark}"
                             cl:Coachmark.Id="wsSearch"
                             Width="190" VerticalAlignment="Center" CornerRadius="6" FontSize="13"
                             IsVisible="{Binding IsTableEditorMode}"
                             KeyDown="OnSearchKeyDown">
                        <TextBox.InnerRightContent>
                            <ToggleButton Classes="explorer-toggle"
                                          cl:Coachmark.Id="wsFilterToggle"
                                          IsChecked="{Binding IsFilterActive}"
                                          Padding="2" MinWidth="20" MinHeight="20"
                                          Margin="0,0,5,0"
                                          ToolTip.Tip="{DynamicResource FilterToggleTip}">
                                <materialIcons:MaterialIcon Kind="FilterOutline" Width="13" Height="13" />
                            </ToggleButton>
                        </TextBox.InnerRightContent>
                        <!-- Anchored to sit exactly ON TOP of the search box (same top-left corner,
                             growing down) instead of below it, so it reads as this exact field
                             expanding in place — its own "find" row covers/replaces the visible
                             search box for as long as it's open. -->
                        <FlyoutBase.AttachedFlyout>
                            <Flyout Placement="AnchorAndGravity" PlacementAnchor="TopLeft" PlacementGravity="BottomRight"
                                    HorizontalOffset="0" VerticalOffset="0">
                                <!-- KeyBindings on WorkspaceView don't see key presses made while focus
                                     is inside this popup (separate overlay layer, not a visual
                                     descendant of WorkspaceView) — Ctrl+H-to-close needs its own
                                     handler here, Escape closes too as a bonus. -->
                                <StackPanel Spacing="8" KeyDown="OnReplaceFlyoutKeyDown">
                                    <TextBox x:Name="FlyoutFindBox" Text="{Binding SearchQuery}" Width="230"
                                             Watermark="{DynamicResource SearchWatermark}"
                                             FontSize="13" CornerRadius="6" KeyDown="OnSearchKeyDown" />
                                    <TextBox x:Name="ReplaceBox" Text="{Binding ReplaceQuery}" Width="230"
                                             Watermark="{DynamicResource ReplaceWatermark}"
                                             FontSize="13" CornerRadius="6" KeyDown="OnReplaceBoxKeyDown" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                        <Button Content="{DynamicResource ReplaceBtn}"
                                                Click="OnReplaceCurrentClick"
                                                Padding="12,6" CornerRadius="6" Cursor="Hand" />
                                        <Button Classes="accent-btn" Content="{DynamicResource ReplaceAllBtn}"
                                                Command="{Binding ReplaceAllCommand}"
                                                Padding="12,6" />
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                    </TextBox>

                    <Button x:Name="ReplaceButton" Classes="toolbar-btn" IsVisible="{Binding IsTableEditorMode}"
                            cl:Coachmark.Id="wsReplace"
                            ToolTip.Tip="{DynamicResource ReplaceTip}"
                            Click="OnReplaceButtonClick">
                        <materialIcons:MaterialIcon Kind="FindReplace" Width="16" Height="16" />
                    </Button>

                    <Border Width="1" Background="{DynamicResource BorderLight}" Margin="6,4" />

                    <Button Classes="toolbar-btn" Command="{Binding SwitchToJsonEditorCommand}"
                            cl:Coachmark.Id="wsSwitchJson"
                            IsVisible="{Binding IsTableEditorMode}"
                            ToolTip.Tip="{DynamicResource SwitchToJsonTip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="CodeBraces" Width="16" Height="16" />
                            <TextBlock Text="{DynamicResource SwitchToJsonBtn}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Classes="toolbar-btn" Command="{Binding SwitchToTableEditorCommand}"
                            cl:Coachmark.Id="wsSwitchTable"
                            IsVisible="{Binding IsJsonEditorMode}"
                            ToolTip.Tip="{DynamicResource SwitchToTableTip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="TableLarge" Width="16" Height="16" />
                            <TextBlock Text="{DynamicResource SwitchToTableBtn}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="{DynamicResource BorderLight}" Margin="6,4"
                            IsVisible="{Binding IsJsonEditorMode}" />

                    <Button Classes="toolbar-btn" Command="{Binding PrettifyJsonCommand}"
                            cl:Coachmark.Id="wsJsonPrettify"
                            IsVisible="{Binding IsJsonEditorMode}"
                            ToolTip.Tip="{DynamicResource PrettifyJsonTip}">
                        <materialIcons:MaterialIcon Kind="FormatIndentIncrease" Width="16" Height="16" />
                    </Button>
                    <Button Classes="toolbar-btn" Command="{Binding MinifyJsonCommand}"
                            cl:Coachmark.Id="wsJsonMinify"
                            IsVisible="{Binding IsJsonEditorMode}"
                            ToolTip.Tip="{DynamicResource MinifyJsonTip}">
                        <materialIcons:MaterialIcon Kind="FormatIndentDecrease" Width="16" Height="16" />
                    </Button>
                    <Button x:Name="JsonFindButton" Classes="toolbar-btn"
                            cl:Coachmark.Id="wsJsonFind"
                            IsVisible="{Binding IsJsonEditorMode}"
                            ToolTip.Tip="{DynamicResource JsonFindTip}">
                        <materialIcons:MaterialIcon Kind="Magnify" Width="16" Height="16" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar Row 2: Add Property -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBackground}" Padding="8,6"
                cl:Coachmark.Id="wsAddProperty"
                CornerRadius="8" Margin="8,6,8,0"
                IsVisible="{Binding IsTableEditorMode}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{DynamicResource AddPropertyLabel}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}" FontSize="13" />

                <TextBox Text="{Binding PropertyName}"
                         Watermark="{DynamicResource PropertyNameWatermark}"
                         Width="200" FontSize="14"
                         x:Name="TBPropertyName"
                         CornerRadius="6" />

                <ComboBox ItemsSource="{Binding AvailableTypes}"
                          SelectedItem="{Binding SelectedType}"
                          Width="140" FontSize="14"
                          Height="{Binding #TBPropertyName.Bounds.Height}"
                          CornerRadius="6" />

                <Button Classes="accent-btn" Content="{DynamicResource AddPropertyBtn}"
                        Height="{Binding #TBPropertyName.Bounds.Height}"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"
                        Command="{Binding AddPropertyCommand}" />
            </StackPanel>
        </Border>

        <!-- Schema + Data (Table Mode) -->
        <Grid Grid.Row="2" Margin="10" x:Name="ContentGrid"
              IsVisible="{Binding IsTableEditorMode}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="240" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" MinWidth="520" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    cl:Coachmark.Id="wsSchema"
                    Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource SchemaHeader}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Grid.Column="1"
                                   Text="{DynamicResource FieldsLabel}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Properties.Count}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <ScrollViewer Grid.Row="2"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Visible">
                        <ItemsControl ItemsSource="{Binding Properties}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:JsonPropertyDefinition}">
                                    <Border Background="{DynamicResource ElevatedBackground}"
                                            BorderBrush="{DynamicResource BorderLight}"
                                            BorderThickness="1"
                                            Margin="0,0,20,0"
                                            CornerRadius="10"
                                            Padding="10">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Grid.Row="0"
                                                       Text="{Binding Name}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextWrapping="Wrap"
                                                       ToolTip.Tip="{Binding Name}" />

                                            <Border Grid.Column="1"
                                                    Grid.Row="0"
                                                    Background="{DynamicResource BorderLight}"
                                                    CornerRadius="999"
                                                    Padding="8,2"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TypeLabel}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondary}" />
                                            </Border>

                                            <Button Grid.Column="2"
                                                    Grid.Row="0"
                                                    Classes="edit-tab"
                                                    Content="{materialIcons:MaterialIconExt Kind=PencilOutline}"
                                                    ToolTip.Tip="{DynamicResource RenameFieldTip}"
                                                    Command="{Binding $parent[UserControl].DataContext.RenamePropertyCommand}"
                                                    CommandParameter="{Binding}" />

                                            <Button Grid.Column="3"
                                                    Grid.Row="0"
                                                    Classes="close-tab"
                                                    Content="{materialIcons:MaterialIconExt Kind=CloseThick}"
                                                    ToolTip.Tip="{DynamicResource RemoveFieldTip}"
                                                    Command="{Binding $parent[UserControl].DataContext.RemovePropertyCommand}"
                                                    CommandParameter="{Binding}" />

                                            <TextBlock Grid.Column="0"
                                                       Grid.Row="1"
                                                       Grid.ColumnSpan="4"
                                                       Text="{Binding Path=FieldType, StringFormat={}Type: {0}}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Margin="0,6,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>


            <GridSplitter Width="5"
                          Background="Transparent"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Grid.Column="1"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" />

            <Border Grid.Column="2"
                    CornerRadius="10"
                    Background="{DynamicResource BorderColor}"
                    Padding="1">
                <Grid RowDefinitions="Auto,*">
                    <!-- Formula bar: shows/edits the current cell's formula (or plain value) —
                         the discoverable way to see and type a formula, rather than requiring the
                         user to already know that typing '=' straight into a grid cell works. -->
                    <Border Grid.Row="0"
                            cl:Coachmark.Id="wsFormulaBar"
                            Background="{DynamicResource ElevatedBackground}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="9,9,0,0"
                            Padding="10,6">
                        <!-- Always visible — even before any cell is selected — so the bar itself
                             is what tells the user "formulas exist," rather than depending on
                             HasCurrentCell ever flipping true first. -->
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                            <materialIcons:MaterialIcon Grid.Column="0"
                                                         Kind="FunctionVariant"
                                                         Width="15" Height="15"
                                                         Opacity="0.55"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,6,0"
                                                         ToolTip.Tip="{DynamicResource FormulaBarTip}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentCellColumnKey}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <TextBox x:Name="FormulaBarTextBox"
                                     Grid.Column="2"
                                     Classes="grid-editor"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontFamily="Cascadia Code,Cascadia Mono,Consolas,Menlo,Courier New,monospace"
                                     FontSize="13"
                                     VerticalContentAlignment="Center"
                                     Watermark="{DynamicResource FormulaBarWatermark}"
                                     KeyDown="OnFormulaBarKeyDown"
                                     TextChanged="OnFormulaBarTextChanged"
                                     LostFocus="OnFormulaBarLostFocus" />
                            <!-- "Apply to the whole column" needs a button, not just the Ctrl+Enter
                                 shortcut it duplicates: a calculated column is the thing most
                                 people actually want when they type their first formula, and a
                                 shortcut nobody can see is a feature nobody finds. Pointer-pressed
                                 rather than Click so the formula bar's LostFocus commit doesn't
                                 fire first and apply the formula to the single cell instead. -->
                            <Button x:Name="ApplyToColumnButton"
                                    cl:Coachmark.Id="wsApplyToColumn"
                                    Grid.Column="3"
                                    Padding="6,2"
                                    Margin="8,0,0,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="{DynamicResource ApplyToColumnTip}">
                                <materialIcons:MaterialIcon Kind="TableColumn" Width="16" Height="16" Opacity="0.7" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Function autocomplete: appears under the formula bar while typing a
                         function name after '='. Tab/Enter accepts the top suggestion; Escape or
                         typing something that matches nothing closes it. Formula-bar only for
                         now — not wired into the grid's own inline cell editor. -->
                    <Popup x:Name="FormulaSuggestionsPopup"
                           PlacementTarget="{Binding #FormulaBarTextBox}"
                           Placement="BottomEdgeAlignedLeft"
                           IsLightDismissEnabled="False"
                           Focusable="False"
                           IsOpen="False">
                        <Border Background="{DynamicResource ElevatedBackground}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="6"
                                MaxHeight="240"
                                MinWidth="280"
                                Padding="4"
                                BoxShadow="0 4 12 0 #40000000">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="FormulaSuggestionsList" Orientation="Vertical" Spacing="1" />
                            </ScrollViewer>
                        </Border>
                    </Popup>

                    <Border Grid.Row="1"
                            CornerRadius="0,0,9,9"
                            Background="{DynamicResource ElevatedBackground}"
                            ClipToBounds="True">
                    <!-- The DataGrid shares this Panel with a hit-test-invisible canvas, which is
                         where the fill-drag preview rectangle is drawn. It has to sit above the
                         grid rather than inside a cell: the range being filled spans many rows, and
                         a preview living in one cell's template would be clipped to that cell. -->
                    <Panel>
                    <DataGrid x:Name="DataGrid"
                              cl:Coachmark.Id="wsGrid"
                              MinWidth="520"
                              RowHeaderWidth="48"
                              ItemsSource="{Binding DisplayedRows}"
                              SelectedItem="{Binding SelectedRow}"
                              AutoGenerateColumns="False"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              SelectionMode="Extended"
                              IsReadOnly="False"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              FontSize="14"
                              Background="Transparent"
                              BorderThickness="0"
                              RowBackground="{DynamicResource ElevatedBackground}">
                        <DataGrid.Styles>
                            <!--Отступ снизу у презентера строк, чтобы горизонтальная полоса прокрутки не перекрывала контент-->
                            <Style Selector="DataGrid /template/ DataGridRowsPresenter">
                                <Setter Property="Margin" Value="0,0,0,16" />
                            </Style>
                        </DataGrid.Styles>
                        <DataGrid.KeyBindings>
                            <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyRowsToJsonCommand}"
                                        CommandParameter="{Binding #DataGrid.SelectedItems}" />
                            <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteRowsToDataGridCommand}" />
                            <KeyBinding Gesture="Ctrl+X" Command="{Binding CutRowsToDataGridCommand}"
                                        CommandParameter="{Binding #DataGrid.SelectedItems}" />
                            <KeyBinding Gesture="Ctrl+D" Command="{Binding DuplicateAfterRowsCommand}"
                                        CommandParameter="{Binding #DataGrid.SelectedItems}" />
                        </DataGrid.KeyBindings>
                        <DataGrid.ContextMenu>
                            <ContextMenu x:Name="DataGridContextMenu">
                                <MenuItem Header="{DynamicResource CtxCut}"
                                          InputGesture="Ctrl+X"
                                          Command="{Binding CutRowsToDataGridCommand}"
                                          CommandParameter="{Binding #DataGrid.SelectedItems}" />
                                <MenuItem Header="{DynamicResource CtxCopyArray}"
                                          InputGesture="Ctrl+C"
                                          Command="{Binding CopyRowsToJsonCommand}"
                                          CommandParameter="{Binding #DataGrid.SelectedItems}" />
                                <MenuItem Header="{DynamicResource CtxCopyObjects}"
                                          Command="{Binding CopyRowsToJsonAsObjectsCommand}"
                                          CommandParameter="{Binding #DataGrid.SelectedItems}" />
                                <MenuItem Header="{DynamicResource CtxPaste}"
                                          InputGesture="Ctrl+V"
                                          Command="{Binding PasteRowsToDataGridCommand}" />
                                <Separator />
                                <MenuItem Header="{DynamicResource CtxExportSelected}"
                                          Command="{Binding ExportSelectedRowsCommand}"
                                          CommandParameter="{Binding #DataGrid.SelectedItems}" />
                                <Separator />
                                <MenuItem Header="{DynamicResource CtxInsertRowAfter}"
                                          Command="{Binding InsertRowAfterCommand}"
                                          CommandParameter="{Binding #DataGrid.SelectedItems}" />
                                <MenuItem Header="{DynamicResource CtxDuplicate}"
                                          Command="{Binding DuplicateRowsCommand}"
                                          CommandParameter="{Binding #DataGrid.SelectedItems}" />
                                <MenuItem Header="{DynamicResource CtxDuplicateAfter}"
                                          InputGesture="Ctrl+D"
                                          Command="{Binding DuplicateAfterRowsCommand}"
                                          CommandParameter="{Binding #DataGrid.SelectedItems}" />
                                <Separator />
                                <MenuItem Header="{DynamicResource CtxFillDown}"
                                          Click="OnFillDownClick">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="ArrowDownBold" Width="16" Height="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <!-- Click handlers rather than bound commands for the same reason
                                     as Fill down above: both act on DataGrid.CurrentColumn, which a
                                     CommandParameter can't express. -->
                                <MenuItem x:Name="ApplyToColumnMenuItem"
                                          Header="{DynamicResource CtxApplyToColumn}"
                                          InputGesture="Ctrl+Enter"
                                          Click="OnApplyToColumnClick">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="TableColumn" Width="16" Height="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="RemoveColumnFormulaMenuItem"
                                          Header="{DynamicResource CtxRemoveColumnFormula}"
                                          Click="OnRemoveColumnFormulaClick">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="TableColumnRemove" Width="16" Height="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{DynamicResource CtxDetachFormulas}"
                                          Command="{Binding DetachFormulasCommand}"
                                          IsVisible="{Binding HasFormulas}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="LinkVariantOff" Width="16" Height="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="{DynamicResource CtxDelete}"
                                          Command="{Binding RemoveRowsCommand}"
                                          CommandParameter="{Binding #DataGrid.SelectedItems}"
                                          Foreground="{DynamicResource DangerColor}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                    <Canvas x:Name="FillPreviewLayer" IsHitTestVisible="False" />
                    </Panel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- JSON Editor (JSON Mode) -->
        <Grid Grid.Row="2" Margin="10" IsVisible="{Binding IsJsonEditorMode}"
              RowDefinitions="Auto,*">

            <!-- Error banner -->
            <Button Grid.Row="0"
                    x:Name="JsonErrorButton"
                    Classes="transparentBtn"
                    ToolTip.Tip="{DynamicResource ErrorBtnTip}"
                    IsVisible="{Binding IsJsonEditorErrorVisible}">
                <Border Classes="json-error-banner">
                    <Grid ColumnDefinitions="Auto,*">
                        <materialIcons:MaterialIcon Grid.Column="0"
                                                    Kind="AlertCircleOutline"
                                                    Width="16"
                                                    Margin="0,0,8,0"
                                                    Height="16"
                                                    Foreground="{DynamicResource DangerColor}" />

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Margin="0,2,0,0"
                                   Text="{Binding JsonEditorError}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </Button>

            <!-- JSON editor: AvaloniaEdit with JSON syntax highlighting and built-in line numbers -->
            <Border Grid.Row="1"
                    cl:Coachmark.Id="wsJsonEditorArea"
                    CornerRadius="10"
                    Background="{DynamicResource BorderColor}"
                    Padding="1">
                <Border CornerRadius="9"
                        Background="{DynamicResource ElevatedBackground}"
                        ClipToBounds="True">
                    <ae:TextEditor x:Name="JsonEditor"
                                   ShowLineNumbers="True"
                                   WordWrap="False"
                                   FontFamily="Cascadia Code,Cascadia Mono,Consolas,Courier New,monospace"
                                   FontSize="13"
                                   Background="Transparent"
                                   Foreground="{DynamicResource TextPrimary}"
                                   LineNumbersForeground="{DynamicResource TextMuted}"
                                   Padding="10,10"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto" />
                </Border>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3"
                Background="{DynamicResource ElevatedBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,1,0,0"
                IsVisible="{Binding IsTableEditorMode}"
                Padding="14,5">
            <StackPanel Orientation="Horizontal" Spacing="24">

                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="{DynamicResource RowsStatusLabel}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMuted}" />
                    <TextBlock Text="{Binding TotalRows}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimary}" />
                </StackPanel>

                <Border Width="1" Background="{DynamicResource BorderLight}" Margin="0,3" />

                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="{DynamicResource SelectedStatusLabel}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMuted}" />
                    <TextBlock Text="{Binding SelectedRowsCount}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimary}" />
                </StackPanel>

                <Border Width="1" Background="{DynamicResource BorderLight}" Margin="0,3" />

                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="{DynamicResource SizeStatusLabel}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMuted}" />
                    <TextBlock Text="{Binding DataSizeKb}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimary}" />
                </StackPanel>

            </StackPanel>
        </Border>

    </Grid>

    <!-- Import / mode switch / reformat all chew on the whole document off-thread;
         without this the window just looks frozen. -->
    <views:BusyOverlay IsActive="{Binding IsBusy}"
                       Message="{DynamicResource BusyProcessing}" />
    </Panel>
</UserControl>